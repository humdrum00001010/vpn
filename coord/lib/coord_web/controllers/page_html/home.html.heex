<div id="coord-landing" class="min-h-screen bg-base-100 text-base-content">
  <a
    href="#main"
    class="btn btn-primary fixed left-4 top-4 z-50 -translate-y-24 focus:translate-y-0"
  >
    Skip to content
  </a>

  <header class="border-b border-base-300">
    <nav class="navbar mx-auto max-w-6xl gap-4 px-6 py-5 sm:px-8" aria-label="Main navigation">
      <a
        href={~p"/"}
        class="flex items-center gap-3 text-xl font-bold tracking-tight"
        aria-label="Coord home"
      >
        <span class="grid size-9 place-items-center rounded-lg bg-primary text-primary-content">
          <.icon name="hero-command-line" class="size-5" />
        </span>
        Coord
      </a>
      <div class="ml-auto flex items-center gap-2 sm:gap-5">
        <a href="#how-it-works" class="btn btn-ghost btn-sm hidden sm:inline-flex">How it works</a>
        <a href="#get-started" class="btn btn-outline btn-sm">Start here
        <.icon name="hero-arrow-up-right" class="size-4" /></a>
      </div>
    </nav>
  </header>

  <main id="main" class="mx-auto max-w-6xl px-6 sm:px-8">
    <section
      class="grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2 lg:gap-16"
      aria-labelledby="landing-title"
    >
      <div>
        <h1
          id="landing-title"
          class="text-5xl font-semibold leading-[1.07] tracking-[-0.035em] sm:text-6xl"
        >
          Your terminal.<br /> Your browser.<br />
          <span class="text-primary">One sign-in.</span>
        </h1>
        <p class="mt-7 max-w-md text-lg leading-relaxed">
          Start with Coord in your terminal. Confirm the link in your email,
          then return to your app with a session of its own.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#get-started" class="btn btn-primary">
            Start with the CLI <.icon name="hero-arrow-right" class="size-4" />
          </a>
          <a href="#how-it-works" class="btn btn-ghost">See how it works</a>
        </div>
        <p class="mt-6 text-sm">Device sign-in for WireGuard coordination.</p>
      </div>

      <div id="get-started" class="min-w-0 scroll-mt-8">
        <div class="mb-3 flex items-center justify-between gap-4">
          <h2 class="text-sm font-semibold">Start in your terminal</h2>
          <span class="text-xs">With the Coord CLI installed</span>
        </div>
        <div class="mockup-code overflow-x-auto bg-neutral py-7 text-neutral-content">
          <pre data-prefix="$" class="text-lg"><code id="login-command">coord login</code></pre>
          <pre data-prefix="" class="mt-7 whitespace-pre-wrap text-sm"><code>Opening the sign-in page…</code></pre>
          <pre data-prefix="" class="mt-2 whitespace-pre-wrap text-sm"><code>Continue in your browser.</code></pre>
          <div class="mx-7 mt-10 border-t border-neutral-content/20 pt-5 text-xs">
            Example sign-in flow
          </div>
        </div>
        <p class="mt-4 text-sm">Your browser opens automatically.</p>
      </div>
    </section>

    <section
      id="how-it-works"
      class="scroll-mt-8 border-t border-base-300 py-14 sm:py-20"
      aria-labelledby="how-title"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 id="how-title" class="text-3xl font-semibold tracking-tight">
          A short trip to your inbox.
        </h2>
        <p class="text-sm">No email prompt in the terminal.</p>
      </div>
      <ol class="steps steps-vertical mt-9 w-full lg:steps-horizontal">
        <li class="step step-primary">
          <div class="py-3 text-left lg:px-5 lg:text-center">
            <h3 class="font-semibold">Run the command</h3>
            <p class="mt-2 max-w-xs text-sm leading-relaxed">
              Start <code class="font-mono">coord login</code>. Coord opens a sign-in page for this CLI session.
            </p>
          </div>
        </li>
        <li class="step step-primary">
          <div class="py-3 text-left lg:px-5 lg:text-center">
            <h3 class="font-semibold">Check your email</h3>
            <p class="mt-2 max-w-xs text-sm leading-relaxed">
              Enter your email in the browser and open the sign-in link we send you.
            </p>
          </div>
        </li>
        <li class="step step-primary">
          <div class="py-3 text-left lg:px-5 lg:text-center">
            <h3 class="font-semibold">Confirm and return</h3>
            <p class="mt-2 max-w-xs text-sm leading-relaxed">
              Confirm the request. Your terminal lets you know when the session is ready.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section
      class="grid gap-10 border-t border-base-300 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16"
      aria-labelledby="sessions-title"
    >
      <div>
        <h2
          id="sessions-title"
          class="max-w-sm text-3xl font-semibold leading-tight tracking-tight"
        >
          Together at sign-in.<br />Separate sessions after.
        </h2>
        <p class="mt-5 max-w-md leading-relaxed">
          Your browser and CLI each get their own session key.
          Ending the CLI session leaves your browser signed in.
        </p>
      </div>
      <dl class="divide-y divide-base-300 border-y border-base-300">
        <div class="flex gap-5 py-6">
          <.icon name="hero-window" class="mt-1 size-6 shrink-0 text-primary" />
          <div>
            <dt class="font-semibold">In your browser</dt>
            <dd class="mt-2 text-sm leading-relaxed">
              Your sign-in persists as you return to Coord.
            </dd>
          </div>
        </div>
        <div class="flex gap-5 py-6">
          <.icon name="hero-command-line" class="mt-1 size-6 shrink-0 text-primary" />
          <div>
            <dt class="font-semibold">In your terminal</dt>
            <dd class="mt-2 text-sm leading-relaxed">
              Keep the CLI open for your active session. Press <kbd class="kbd kbd-sm">Enter</kbd>
              to end it.
            </dd>
          </div>
        </div>
      </dl>
    </section>

    <section class="border-t border-base-300 py-14 sm:py-20" aria-labelledby="help-title">
      <h2 id="help-title" class="text-3xl font-semibold tracking-tight">
        A little help, if you need it.
      </h2>
      <div class="mt-7 space-y-3">
        <details
          id="browser-help"
          class="collapse collapse-arrow rounded-lg border border-base-300 bg-base-100"
        >
          <summary class="collapse-title font-semibold">My browser didn’t open.</summary>
          <div class="collapse-content text-sm leading-relaxed">
            <p>The CLI also prints the sign-in link. Copy it into your browser to continue.</p>
          </div>
        </details>
        <details class="collapse collapse-arrow rounded-lg border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">The sign-in link expired.</summary>
          <div class="collapse-content text-sm leading-relaxed">
            <p>
              Run <code class="font-mono">coord login</code>
              again to start a new request, then use the newest email link.
            </p>
          </div>
        </details>
      </div>
    </section>
  </main>

  <footer class="border-t border-base-300">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-7 text-sm sm:px-8">
      <span class="font-semibold">Coord</span>
      <a href="#get-started" class="link link-hover underline-offset-4">Back to the command</a>
    </div>
  </footer>
  <Layouts.flash_group flash={@flash} />
</div>
